{
  "name": "@ryangarber/legiscan-ts",
  "version": "3.0.0",
  "description": "A TypeScript client for the Legiscan API.",
  "author": "Ryan Garber",
  "contributors": [
    "Civic News"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryangarber/legiscan-ts.git"
  },
  "homepage": "https://github.com/ryangarber/legiscan-ts#readme",
  "bugs": {
    "url": "https://github.com/ryangarber/legiscan-ts/issues"
  },
  "license": "GPL-3.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "legiscan": "dist/cli.mjs"
  },
  "scripts": {
    "cli": "node src/cli.ts",
    "build": "tsdown && pnpm man",
    "build:cli": "node ./scripts/build.ts",
    "lint": "biome check --write .",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "typegen": "node ./scripts/typegen.ts",
    "man": "node ./scripts/man.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@optique/core": "^1.3.6",
    "@optique/man": "^1.3.6",
    "@optique/run": "^1.3.6",
    "comment-parser": "^1.4.9",
    "listr2": "^11.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "json-schema-to-typescript": "^16.0.0",
    "knip": "^6.42.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "26.12.1",
        "onFail": "download"
      },
      {
        "name": "bun",
        "version": ">=1.4.0",
        "onFail": "download"
      }
    ]
  },
  "man": "./dist/legiscan.1"
}
