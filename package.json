{
	"name": "legiscan-ts",
	"version": "3.0.2",
	"description": "A TypeScript client for the Legiscan API.",
	"author": "Ryan Garber",
	"contributors": [
		"Civic News"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ryangarber/legiscan-ts.git"
	},
	"homepage": "https://github.com/ryangarber/legiscan-ts#readme",
	"bugs": {
		"url": "https://github.com/ryangarber/legiscan-ts/issues"
	},
	"license": "GPL-3.0",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"legiscan": "./dist/cli.mjs"
	},
	"scripts": {
		"cli": "node ./src/cli.ts",
		"types": "zinfer --with-descriptions --suffix='Schema' --output-only --output-suffix='' --outFile='./src/types.g.ts' ./src/types.ts",
		"build": "pnpm types && tsdown && pnpm man",
		"build:cli": "pnpm types && node ./scripts/build-cli.ts",
		"lint": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"man": "node ./scripts/build-man.ts"
	},
	"dependencies": {
		"@clack/prompts": "^1.9.0",
		"@optique/core": "^1.4.0",
		"@optique/man": "^1.4.0",
		"@optique/run": "^1.4.0",
		"comment-parser": "^1.4.9",
		"listr2": "^11.4.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@ryangarber/utils": "^0.1.6",
		"@types/node": "^26.6.6",
		"dotenv": "^18.0.10",
		"knip": "^6.46.1",
		"tsdown": "^0.23.7",
		"typedoc": "^0.28.20",
		"typescript": "7.1.0-beta",
		"vitest": "^5.1.1",
		"zinfer": "^0.5.5"
	},
	"packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
	"devEngines": {
		"runtime": [
			{
				"name": "node",
				"version": ">=24 <27",
				"onFail": "download"
			},
			{
				"name": "bun",
				"version": ">=1.4 <2",
				"onFail": "download"
			}
		]
	},
	"man": "./dist/legiscan.1"
}
