{
  "name": "@ryangarber/legiscan-ts",
  "version": "2.1.2",
  "description": "A TypeScript client for the Legiscan API.",
  "author": "Ryan Garber",
  "contributors": [
    "Civic News"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanGarber/legiscan-ts.git"
  },
  "homepage": "https://github.com/RyanGarber/legiscan-ts#readme",
  "bugs": {
    "url": "https://github.com/RyanGarber/legiscan-ts/issues"
  },
  "license": "GPL-3.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "legiscan": "dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "build:cli": "tsx scripts/build.ts",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepublishOnly": "npm run check && npm test -- --run && npm run build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "typegen": "tsx scripts/typegen.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "comment-parser": "^1.4.8",
    "lowdb": "^7.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@eslint/js": "^10.0.1",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.2.0",
    "bumpp": "^12.2.1",
    "cli-progress": "^3.12.0",
    "csv": "^6.6.3",
    "dotenv": "^17.4.2",
    "globals": "^17.11.0",
    "json-schema-to-typescript": "^15.0.4",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
