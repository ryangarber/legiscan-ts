{
  "name": "legiscan-ts",
  "version": "3.0.0",
  "description": "A TypeScript client for the Legiscan API.",
  "author": "Ryan Garber",
  "contributors": [
    "Civic News"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryangarber/legiscan-ts.git"
  },
  "homepage": "https://github.com/ryangarber/legiscan-ts#readme",
  "bugs": {
    "url": "https://github.com/ryangarber/legiscan-ts/issues"
  },
  "license": "GPL-3.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "legiscan": "./dist/cli.mjs"
  },
  "scripts": {
    "cli": "node ./src/cli.ts",
    "build": "tsdown && pnpm man",
    "build:cli": "node ./scripts/build.ts",
    "lint": "biome check --write .",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "typegen": "node ./scripts/typegen.ts",
    "man": "node ./scripts/man.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@optique/core": "^1.3.6",
    "@optique/man": "^1.3.6",
    "@optique/run": "^1.3.6",
    "comment-parser": "^1.4.9",
    "listr2": "^11.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "json-schema-to-typescript": "^16.0.0",
    "knip": "^6.45.1",
    "tsdown": "^0.23.7",
    "typedoc": "^0.28.20",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "26.13.1",
        "onFail": "download"
      },
      {
        "name": "bun",
        "version": ">=1.4 <2",
        "onFail": "download"
      }
    ]
  },
  "man": "./dist/legiscan.1"
}
